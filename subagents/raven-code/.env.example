# Copy to `.env`, fill in, and `chmod 600 .env`.
#
# run.py merges these into a config it renders at launch, because the runtime's
# config loader does no environment-variable substitution and reads none of
# these from the environment itself. `config.json` therefore stays free of
# secrets and is safe to publish.
#
# Every value here can also be exported in the environment instead, which wins
# over this file.

# LLM provider key, for the `providers.custom.apiBase` in config.json
# (an OpenRouter key by default). Required - the run exits 1 without it.
CODE_API_KEY=

# Serper key for web search (https://serper.dev). Optional: without it the
# agent still codes, it just cannot look anything up.
CODE_SERPER_API_KEY=

# Optional. `r.jina.ai` is called unauthenticated when this is empty, at a
# lower rate limit. Leave it empty rather than setting an exhausted key: an
# out-of-credit key answers 402 where no key at all answers 200, so a dead key
# disables page reading entirely.
CODE_JINA_API_KEY=


# The product's work - its repos, its worktrees, and the CLI compatibility
# path's instance-<id>/ buckets - lands under this root, never in this folder or
# the Working directory. Defaults to <host Agent home>/subagent_sessions/raven-code.
#
# NOT the ACP engine's own state: its sessions, cache and launcher log follow
# CODE_ACP_HOME below, which is deliberately outside the host's Agent home.
CODE_STATE_ROOT=

# The ACP engine's own Agent home. Defaults to
# <raven data directory>/subagent_sessions/raven-code/acp - deliberately NOT
# under the host's Agent home, which the host also hands out as a session's
# Working directory: a raven engine refuses to work in a directory containing
# its own home, so an engine homed there can never be dispatched to.
#
# If the host's Agent home is configured to contain the raven data directory,
# the default would be inside it too, and the engine is homed beside the Agent
# home instead - named for this RAVEN_HOME, so two instances on one machine keep
# their conversations apart.
CODE_ACP_HOME=

# Interpreter the gateway is told to invoke, used by install.py only.
# run.py is standard-library only, so any python3 works.
SUBAGENT_PYTHON=

# Interpreter that has the *host* raven installed. install.py performs its
# config write through this one, since the runtime is rarely importable from
# the interpreter the installer itself runs under. Defaults to the shebang of
# `raven` on PATH.
RAVEN_PYTHON=
