# Copy to `.env`, fill in, and `chmod 600 .env`.
#
# run.py merges these into a config it renders at launch, because Raven-X's
# config loader does no environment-variable substitution and reads none of
# these from the environment itself. `config.json` therefore stays free of
# secrets and is safe to publish.
#
# Every value here can also be exported in the environment instead, which wins
# over this file.

# LLM provider key, for the `providers.openrouter.apiBase` in config.json
# (an OpenRouter key by default). Required - the run exits 1 without it.
RESEARCH_API_KEY=

# Web vendor keys. One line per VENDOR, not per tool: `tools.web.search.provider`
# and `tools.web.fetch.provider` in config.json each name a vendor, and both can
# name the same one - AnySearch serves search and page reading off one account,
# so its key is filled in once here and used by whichever tool selects it.

# The key for whichever backend `tools.web.search.provider` selects. Required -
# the run exits 1 without one, because an agent whose search tool is withheld
# answers from memory and reads like an ordinary run. Set
# `tools.web.corpusEndpoint` instead to run against a fixed corpus, which is the
# one case that needs no key.
#
#   serper    (default, https://serper.dev)
RESEARCH_SERPER_API_KEY=
#   serpapi   (https://serpapi.com)
RESEARCH_SERPAPI_API_KEY=
#   anysearch (https://anysearch.com/console/api-keys). Serves no page beyond
#             the first, so search depth is unavailable on this backend; its
#             anonymous tier is deliberately NOT accepted as configured. The
#             same key also serves `tools.web.fetch.provider = "anysearch"`.
RESEARCH_ANYSEARCH_API_KEY=
#   tavily    (https://tavily.com). No result offset, so search depth is
#             unavailable; the same key serves `tools.web.fetch.provider = "tavily"`.
RESEARCH_TAVILY_API_KEY=
#   exa       (https://exa.ai). No result offset; the same key serves
#             `tools.web.fetch.provider = "exa"`.
RESEARCH_EXA_API_KEY=
#   brave     (https://brave.com/search/api). Pages by page index. Search only -
#             Brave has no page-reading endpoint.
RESEARCH_BRAVE_API_KEY=
#   firecrawl (https://firecrawl.dev). No result offset; the same key serves
#             `tools.web.fetch.provider = "firecrawl"`.
RESEARCH_FIRECRAWL_API_KEY=

# When `config.json` names no `tools.web.search.provider` / `tools.web.fetch.provider`,
# the host raven's choice (its `raven onboard` web step) is inherited, as are its
# vendor keys under `tools.web.providers.<vendor>.apiKey`.

# The key for whichever backend `tools.web.fetch.provider` selects, plus any it
# lists under `tools.web.fetch.fallback`.
#
#   jina      (default, https://jina.ai/reader) - OPTIONAL. `r.jina.ai` is
#             called unauthenticated when this is empty, at a lower rate limit.
#             Leave it empty rather than setting an exhausted key: an
#             out-of-credit key answers 402 where no key at all answers 200, so
#             a dead key disables page reading entirely.
RESEARCH_JINA_API_KEY=
#   anysearch - REQUIRED when selected or listed as a fallback; it has no
#             anonymous tier for page reading. Its key is the one above.
#             Not interchangeable with jina: measured on one Wikipedia article
#             it returned 49,890 characters against jina's 27,786 for the same
#             page, because it keeps the navigation chrome jina strips, and it
#             carries no publication date. An arm reading pages through it is a
#             different arm, not the same arm on another vendor.
#   tavily / exa / firecrawl - REQUIRED when selected or listed as a fallback;
#             none has an anonymous tier for page reading. Their keys are the
#             search-side lines above.


# Everything the agent persists - transcripts above all, plus the runtime's
# own cache, logs and workspace - lands under this root, never in this
# folder. It is the config's parent that decides, so run.py renders the
# config here; there is no separate knob for the session directory.
# Defaults to ~/.raven/workspace/subagent_sessions/raven-research
RESEARCH_STATE_ROOT=

# Interpreter the gateway is told to invoke, used by install.py only.
# run.py is standard-library only, so any python3 works.
SUBAGENT_PYTHON=

# Interpreter that has the *host* raven installed. install.py performs its
# config write through this one, since the runtime is rarely importable from
# the interpreter the installer itself runs under. Defaults to the shebang of
# `raven` on PATH.
RAVEN_PYTHON=
