{
  "providers": {
    "openrouter": {
      "apiBase": "https://openrouter.ai/api/v1",
      "apiKey": "PUT_YOUR_LLM_API_KEY_HERE"
    }
  },
  "agents": {
    "defaults": {
      "model": "anthropic/claude-sonnet-5",
      "provider": "openrouter",
      "temperature": 0.7,
      "maxToolIterations": 40,
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "requestTimeoutSeconds": 600
    }
  },
  "memory": {
    "backend": "everos",
    "userId": "demo_user",
    "agentId": "demo_agent",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "everos-memory": {
        "mode": "http",
        "base_url": "http://127.0.0.1:8000",
        "api_version": "auto",
        "require_service": true,
        "app_id": "raven",
        "project_id": "demo",
        "user_id": "demo_user",
        "agent_id": "demo_agent",
        "session_id_prefix": "raven",
        "defer_extraction": false,
        "flush_every_turns": 1,
        "emit_user_messages": true,
        "recall_enabled": false,
        "recall_memory_enabled": true,
        "recall_skills_enabled": true
      }
    }
  },
  "drFlow": {
    "enabled": false,
    "finalShape": {
      "record": false,
      "requireMarker": false,
      "reportStructure": false,
      "reportFormatOverride": false,
      "reportDepth": false,
      "reportReminder": false,
      "reportBounce": false,
      "processAppendix": false
    }
  }
}
