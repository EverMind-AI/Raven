{
 "providers": {
  "openrouter": {
   "apiBase": "https://openrouter.ai/api/v1",
   "apiKey": "PUT_YOUR_LLM_API_KEY_HERE"
  }
 },
 "agents": {
  "defaults": {
   "model": "anthropic/claude-sonnet-5",
   "provider": "openrouter",
   "temperature": 0.3,
   "maxToolIterations": 40,
   "maxTokens": 8192,
   "contextWindowTokens": 200000,
   "requestTimeoutSeconds": 900
  }
 },
 "memory": {
  "backend": null
 },
 "drFlow": {
  "enabled": true,
  "thinkClosingTagRequired": false,
  "maxIterations": 20,
  "spinBreaker": {
   "enabled": true
  },
  "fetchFloor": {
   "enabled": true
  },
  "verify": {
   "enabled": true,
   "maxRevisions": 1,
   "strictRejectOnly": true
  },
  "digest": {
   "verbatimHeadChars": 800
  },
  "search": {
   "includeSnippets": true,
   "saturation": {
    "enabled": true,
    "k": 8,
    "onSaturate": "widen",
    "maxPages": 2
   }
  },
  "toolsAllowlist": [
   "web_search",
   "web_fetch",
   "ask_user"
  ],
  "finalShape": {
   "record": true,
   "requireMarker": false,
   "reportStructure": true,
   "reportFormatOverride": true,
   "reportDepth": true,
   "reportReminder": true,
   "reportBounce": false,
   "processAppendix": true
  },
  "conversation": {
   "enabled": true,
   "gate": "agentic",
   "researchMemo": true,
   "identityScope": "topic"
  },
  "askUser": {
   "enabled": true,
   "mode": "first_turn",
   "delivery": "tool",
   "outline": true,
   "maxRounds": 1,
   "firstIterationOnly": true,
   "briefRequiresAnswerCheck": true,
   "replyOverlapThreshold": 0.05,
   "maxQuestions": 3,
   "maxOutlineItems": 5,
   "promptClause": true,
   "brief": false
  }
 },
 "tools": {
  "web": {
   "benchmarkContainment": false
  },
  "disabledTools": [
   "exec",
   "spawn",
   "message",
   "cron",
   "read_file",
   "write_file",
   "edit_file",
   "find",
   "grep",
   "list_dir",
   "read_skill",
   "use_skill",
   "tool_search",
   "tool_call",
   "image_generate",
   "text_to_speech",
   "video_generate",
   "understand_media"
  ]
 }
}
