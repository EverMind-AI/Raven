# Copy to `.env`, fill in only the values this worker owns, and `chmod 600 .env`.
# Exported environment variables override this file.

# Optional when the host Raven already has a provider key. With no value here,
# run.py inherits the host provider block, routing, selected model, and protocol.
# With a value, config.json uses OpenRouter and openai/gpt-5.4 by default.
DESIGN_API_KEY=

# Optional OpenRouter image-generation key. When blank, run.py reuses a
# compatible host OpenRouter media/provider key; otherwise image_generate is not
# registered. Non-OpenRouter image API shapes require a matching tool backend.
DESIGN_IMAGE_API_KEY=

# Optional Serper and Jina keys. Blank values inherit the host tool keys.
DESIGN_SERPER_API_KEY=
DESIGN_JINA_API_KEY=

# Runtime transcripts, rendered secret-bearing configs, caches, and state.
# Defaults to ~/.raven/workspace/subagent_sessions/raven-design.
DESIGN_STATE_ROOT=

# Launcher state and logs. Defaults to <state root>/runs.
DESIGN_RUN_ROOT=

# Interpreter used by the host subagent command. Any Python 3 interpreter works
# because run.py uses only the standard library.
SUBAGENT_PYTHON=

# Interpreter with the host Raven installed, used by install.py.
RAVEN_PYTHON=
