{
  "language": "zh",
  "providers": {
    "custom": {
      "apiBase": "https://openrouter.ai/api/v1",
      "models": [
        "openai/gpt-5.4"
      ],
      "protocol": "chat"
    }
  },
  "agents": {
    "defaults": {
      "model": "openai/gpt-5.4",
      "provider": "custom",
      "reasoningEffort": "high",
      "temperature": 0.1,
      "contextWindowTokens": 262144,
      "maxToolIterations": 150,
      "llmCallTimeout": 1800,
      "contextCompaction": {
        "enabled": true,
        "triggerRatio": 0.8,
        "targetRatio": 0.5,
        "tailRatio": 0.2,
        "minRecentIterations": 4,
        "maxUserTokens": 20000,
        "safetyMarginTokens": 8192,
        "summaryMinTokens": 2048,
        "summaryMaxTokens": 12000,
        "maxCompactionsPerTurn": 4,
        "retryAfterIterations": 2,
        "minSavingsRatio": 0.15,
        "maxToolResultChars": 64000
      }
    }
  },
  "tools": {
    "restrictToWorkspace": false,
    "sandbox": {
      "backend": "none"
    },
    "exec": {
      "timeout": 600
    },
    "render": {
      "enabled": true,
      "backend": "direct",
      "defaultPreviewCount": 6,
      "maxPreviewCount": 12,
      "timeoutSeconds": 240
    },
    "media": {
      "image": {
        "allowModelOverride": false,
        "apiBase": "https://openrouter.ai/api/v1",
        "apiStyle": "openrouter_images",
        "model": "openai/gpt-image-2"
      },
      "outputSubdir": "generated"
    },
    "web": {
      "search": {
        "maxResults": 5
      }
    },
    "disabledTools": [
      "spawn",
      "message",
      "cron",
      "ask_user",
      "deep_research",
      "text_to_speech",
      "video_generate"
    ]
  },
  "skillForge": {
    "enabled": true,
    "visualDomainSelector": {
      "enabled": true,
      "preferredMax": 2,
      "alternativesMax": 3,
      "temperature": 0.0,
      "maxTokens": 8192
    }
  },
  "context": {
    "curatorModel": ""
  },
  "memory": {
    "backend": "everos",
    "userId": "raven-design",
    "agentId": "raven-design",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "everos-memory": {
        "mode": "http",
        "base_url": "http://localhost:18791",
        "user_id": "raven-design",
        "agent_id": "raven-design"
      }
    }
  }
}
