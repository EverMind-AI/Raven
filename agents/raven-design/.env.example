# Copy to `.env`, fill in, and `chmod 600 .env`.
#
# run.py merges these into the config it renders at launch; config.json stays
# free of secrets and is safe to publish. Every value can also be exported in
# the environment instead, which wins over this file.
#
# The vendored fork launcher cited a file like this one and never shipped it;
# this product does (fork-side defect, fixed in the rebuild).

# LLM provider key, written to every provider block in config.json (an
# OpenRouter key by default; the shipped provider block is `custom`, tuned for
# openai/gpt-5.6-sol). Leave it empty to inherit the host raven's whole LLM
# configuration instead (providers, routing, default provider/model); the run
# exits 1 only when neither exists.
DESIGN_API_KEY=

# Image-generation key for tools.media.image - OPTIONAL, resolved through a
# waterfall when empty: the host's tools.media.image key (with its base and
# model) when that endpoint is OpenRouter-shaped, then the host's openrouter
# provider key, then DESIGN_API_KEY itself when the configured image endpoint
# is already OpenRouter. No key anywhere withholds the image_generate tool
# rather than offering one that cannot answer.
DESIGN_IMAGE_API_KEY=

# Serper key for tools.web.search (https://serper.dev) - OPTIONAL: it falls
# back to the same path in the host config, and without one anywhere the
# agent loses web image/reference search.
DESIGN_SERPER_API_KEY=

# Jina Reader key for tools.web.jinaApiKey - OPTIONAL. r.jina.ai works
# unauthenticated at a lower rate limit; leave this empty rather than setting
# an exhausted key (a dead key answers 402 where no key answers 200).
DESIGN_JINA_API_KEY=

# Everything the agent persists lands under this root, never in this folder:
# the rendered config and the launcher's working state. Defaults to
# <raven home>/workspace/subagent_sessions/raven-design.
DESIGN_STATE_ROOT=

# Where the ACP engine keeps its own Agent home (identity, sessions, skill
# pool) - OPTIONAL, and outside the host Agent home by construction when
# unset: <raven home>/subagent_sessions/raven-design/acp, falling beside the
# host Agent home (tagged per instance) when that home swallows the default.
# The host hands its own Agent home out as a session's working directory,
# and an engine homed inside that tree makes every such dispatch refuse.
# Set this to move it; where it goes is then your business.
DESIGN_ACP_HOME=
