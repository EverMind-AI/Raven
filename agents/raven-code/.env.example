# Copy to `.env`, fill in, and `chmod 600 .env`.
#
# run.py merges these into the config it renders at launch; config.json stays
# free of secrets and is safe to publish. Every value can also be exported in
# the environment instead, which wins over this file.

# LLM provider key for providers.custom in config.json (an OpenRouter key by
# default). Leave it empty to inherit the host raven's whole LLM configuration
# instead (providers, routing, default provider/model); the run exits 1 only
# when neither exists.
CODE_API_KEY=

# Serper key for tools.web.search (https://serper.dev) - OPTIONAL: it falls
# back to the same path in the host config, and without one anywhere the
# agent still codes, it just cannot look anything up.
CODE_SERPER_API_KEY=

# Jina Reader key for tools.web.jinaApiKey - OPTIONAL. r.jina.ai works
# unauthenticated at a lower rate limit; leave this empty rather than setting
# an exhausted key (a dead key answers 402 where no key answers 200).
CODE_JINA_API_KEY=

# Everything the agent WORKS ON lands under this root, never in this folder
# and never in the session's working directory: instance-<id>/ holds one CLI
# conversation's records (--task); repos/ holds repo-level owners, locks and
# worktrees, shared by both hostings so they contend over the same checkouts.
# The ACP hosting's rendered config, runtime data dir, pinned Agent home and
# per-session allocation records live under CODE_ACP_HOME instead (below):
# the host hands its own Agent home out as a session's working directory, and
# an engine homed inside that tree makes every such dispatch refuse.
# A relative value resolves under the host Agent home. Defaults to
# <host Agent home>/subagent_sessions/raven-code, where the host Agent home
# is the host config's agents.defaults.workspace (or <raven home>/workspace).
CODE_STATE_ROOT=

# Where the ACP engine keeps its own Agent home (rendered config, runtime
# data dir, per-session allocation records) - OPTIONAL, and outside the host
# Agent home by construction when unset: <raven home>/subagent_sessions/
# raven-code/acp, falling beside the host Agent home (tagged per instance)
# when that home swallows the default. Set this to move it; where it goes is
# then your business, reachability included.
CODE_ACP_HOME=
