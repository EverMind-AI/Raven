# Copy to `.env`, fill in, and `chmod 600 .env`.
#
# run.py merges these into the config it renders at launch; config.json stays
# free of secrets and is safe to publish. Every value can also be exported in
# the environment instead, which wins over this file.

# LLM provider key for providers.openrouter in config.json. Leave it empty to
# inherit the host raven's whole LLM configuration instead (providers,
# routing, default provider/model); the run exits 1 only when neither exists.
RESEARCH_API_KEY=

# Which vendor each web tool calls - OPTIONAL. Search: serper (default),
# anysearch, serpapi, tavily, exa, brave, firecrawl, serply. Fetch: jina (default),
# anysearch, tavily, exa, firecrawl. Empty here falls back to this product's
# config.json, then the host raven's tools.web.{search,fetch}.provider. A name
# not on the list refuses to launch. A fetch vendor selected without its key
# reads pages through Jina instead, and says so in the log.
RESEARCH_WEB_SEARCH_PROVIDER=
RESEARCH_WEB_FETCH_PROVIDER=

# Serper key for tools.web.search (https://serper.dev), the default search
# vendor. The run exits 1 when the SELECTED search vendor has no key here, in
# the host config, or as its bare env var (SERPER_API_KEY for this one) -- an
# agent whose search tool is withheld answers from memory and reads like an
# ordinary run.
RESEARCH_SERPER_API_KEY=

# Jina Reader key for tools.web.jinaApiKey - OPTIONAL. r.jina.ai works
# unauthenticated at a lower rate limit; leave this empty rather than setting
# an exhausted key (a dead key answers 402 where no key answers 200).
RESEARCH_JINA_API_KEY=

# One key per other vendor, at the same path the host raven holds it
# (tools.web.providers.<vendor>.apiKey) - each OPTIONAL, inherited from the
# host config when empty here. Only the selected vendors' keys are used.
RESEARCH_ANYSEARCH_API_KEY=
RESEARCH_SERPAPI_API_KEY=
RESEARCH_TAVILY_API_KEY=
RESEARCH_EXA_API_KEY=
RESEARCH_BRAVE_API_KEY=
RESEARCH_FIRECRAWL_API_KEY=
RESEARCH_SERPLY_API_KEY=

# HTTP/SOCKS5 proxy for both web tools, e.g. http://127.0.0.1:7890 - OPTIONAL.
# Empty here and absent from the host config means a direct connection (httpx
# still honours HTTP_PROXY / HTTPS_PROXY from the environment either way).
RESEARCH_WEB_PROXY=

# Everything the agent persists lands under this root, never in this folder:
# the workspace, the rendered config, and the research-flow plugin's own
# state (session memos, pending clarifications, per-turn research trails).
# Defaults to <raven home>/workspace/subagent_sessions/raven-research-ng.
RESEARCH_NG_STATE_ROOT=

# Where the ACP engine keeps its own Agent home (identity, sessions, skill
# pool) - OPTIONAL, and outside the host Agent home by construction when
# unset: <raven home>/subagent_sessions/raven-research-ng/acp, falling beside the
# host Agent home (tagged per instance) when that home swallows the default.
# The host hands its own Agent home out as a session's working directory,
# and an engine homed inside that tree makes every such dispatch refuse.
# Set this to move it; where it goes is then your business.
RESEARCH_NG_ACP_HOME=
