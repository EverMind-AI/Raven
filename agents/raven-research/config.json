{
  "providers": {
    "openrouter": {
      "apiBase": "https://openrouter.ai/api/v1"
    }
  },
  "agents": {
    "defaults": {
      "model": "openai/gpt-5.6-sol-pro",
      "provider": "openrouter",
      "reasoningEffort": "high",
      "maxToolIterations": 40,
      "maxTokens": 16384,
      "contextWindowTokens": 65536,
      "requestTimeoutSeconds": 600
    }
  },
  "memory": {
    "backend": "everos",
    "userId": "raven-research-ng",
    "agentId": "raven-research-ng",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "everos-memory": {
        "mode": "http",
        "base_url": "http://localhost:18791",
        "user_id": "raven-research-ng",
        "agent_id": "raven-research-ng",
        "timeout_s": 360
      },
      "research-flow": {
        "enabled": true,
        "thinkClosingTagRequired": false,
        "maxIterations": 20,
        "budgetNote": {
          "enabled": true,
          "warnRatio": 0.3
        },
        "forceFinalize": {
          "enabled": true
        },
        "spinBreaker": {
          "enabled": true
        },
        "fetchFloor": {
          "enabled": true
        },
        "fetchGate": {
          "enabled": true,
          "k": 15
        },
        "sufficiency": {
          "enabled": true,
          "minSearches": 1,
          "minFetches": 2,
          "timeoutSeconds": 30,
          "attemptTimeoutSeconds": 15
        },
        "verify": {
          "constraintRubric": true,
          "strictRejectOnly": true,
          "timeoutSeconds": 120,
          "attemptTimeoutSeconds": 40
        },
        "digest": {
          "verbatimHeadChars": 800
        },
        "search": {
          "includeSnippets": true,
          "snippetDedupByDocid": true,
          "saturation": {
            "enabled": true,
            "k": 5,
            "onSaturate": "widen"
          }
        },
        "finalShape": {
          "record": true,
          "requireMarker": false,
          "reportStructure": true,
          "reportFormatOverride": true,
          "reportDepth": true,
          "reportReminder": true,
          "reportBounce": false,
          "processAppendix": true
        },
        "askUser": {
          "enabled": true,
          "mode": "when_needed",
          "delivery": "tool"
        },
        "conversation": {
          "enabled": true,
          "gate": "agentic",
          "gateMaxTokens": 4096,
          "gateTimeoutSeconds": 90,
          "researchMemo": true,
          "identityScope": "turn"
        },
        "version": "dr@3.7-filetools-askuser-derive-numeric-cite-rank"
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "maxResults": 5
      }
    },
    "disabledTools": [
      "exec",
      "spawn",
      "message",
      "cron",
      "read_skill",
      "use_skill",
      "find_skill",
      "tool_search",
      "tool_call",
      "image_generate",
      "text_to_speech",
      "video_generate",
      "understand_media",
      "deep_research",
      "deliver_files",
      "plugin",
      "create_playbook",
      "load_playbook",
      "run_subagent_dag"
    ]
  },
  "context": {
    "dropSegments": [
      "identity",
      "memory",
      "active_skills",
      "skills"
    ]
  }
}
