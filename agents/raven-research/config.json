{
  "providers": {
    "openrouter": {
      "apiBase": "https://openrouter.ai/api/v1"
    }
  },
  "agents": {
    "defaults": {
      "model": "openai/gpt-5.6-sol-pro",
      "provider": "openrouter",
      "reasoningEffort": "high",
      "maxToolIterations": 40,
      "maxTokens": 16384,
      "contextWindowTokens": 65536,
      "requestTimeoutSeconds": 600
    }
  },
  "memory": {
    "backend": "everos",
    "userId": "raven-research-ng",
    "agentId": "raven-research-ng",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "everos-memory": {
        "mode": "http",
        "base_url": "http://localhost:18791",
        "user_id": "raven-research-ng",
        "agent_id": "raven-research-ng",
        "timeout_s": 360
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "maxResults": 5
      }
    },
    "disabledTools": [
      "exec",
      "spawn",
      "message",
      "cron",
      "read_skill",
      "use_skill",
      "tool_search",
      "tool_call",
      "image_generate",
      "text_to_speech",
      "video_generate",
      "understand_media"
    ]
  }
}
