{
  "language": "en",
  "agents": {
    "defaults": {
      "model": "z-ai/glm-5.3-flash",
      "provider": "ppt",
      "contextWindowTokens": 1000000,
      "llmCallTimeout": 1800,
      "maxToolIterations": 600,
      "maxConcurrentSubagents": 2,
      "reasoningEffort": "high",
      "temperature": 0.95,
      "modelOverrides": {
        "grok": {
          "extra_body": {
            "provider": {
              "only": [
                "xAI"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "glm-5.3-flash": {
          "extra_body": {
            "provider": {
              "order": [
                "Z.AI",
                "DeepInfra",
                "Novita"
              ],
              "allow_fallbacks": false
            }
          }
        }
      },
      "llmErrorRetryDelays": [
        30,
        60,
        120,
        240,
        300,
        300,
        300,
        300
      ],
      "llmRetryAfterOutput": true,
      "compaction": {
        "enabled": true,
        "triggerRatio": 0.85
      }
    }
  },
  "providers": {
    "ppt": {
      "apiBase": "https://openrouter.ai/api/v1",
      "models": [
        "z-ai/glm-5.3-flash"
      ]
    }
  },
  "tools": {
    "restrictToWorkspace": false,
    "exec": {
      "denyPatterns": [
        "\\bdel\\s+/[fq]\\b",
        "\\brmdir\\s+/s\\b",
        "(?:^|[;&|]\\s*)format\\b",
        "\\b(mkfs|diskpart)\\b",
        "\\bdd\\s+if=",
        ">\\s*/dev/sd",
        ":\\(\\)\\s*\\{.*\\};\\s*:"
      ]
    },
    "sandbox": {
      "backend": "none"
    },
    "web": {
      "search": {
        "maxResults": 10
      }
    },
    "disabledTools": [
      "create_playbook",
      "cron",
      "deep_research",
      "deliver_files",
      "find_skill",
      "hub",
      "image_generate",
      "load_playbook",
      "plugin",
      "read_skill",
      "run_subagent_dag",
      "text_to_speech",
      "tool_call",
      "tool_search",
      "video_generate"
    ]
  },
  "context": {
    "curator_model": ""
  },
  "memory": {
    "backend": "everos",
    "userId": "raven-design",
    "agentId": "raven-design",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "everos-memory": {
        "base_url": "http://localhost:18791"
      },
      "ppt-engine": {
        "enabled": true,
        "profile": "script_author",
        "composerModel": "",
        "readerEffort": "low",
        "renderDpi": 144
      }
    }
  }
}
