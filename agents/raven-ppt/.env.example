# Copy to `.env`, fill in, and `chmod 600 .env`.
#
# run.py merges these into the config it renders at launch; config.json stays
# free of secrets and is safe to publish. Every value can also be exported in
# the environment instead, which wins over this file.

# LLM provider key, written to every provider block in config.json (an
# OpenRouter key by default). Leave it empty to inherit the host raven's whole
# LLM configuration instead (providers, routing, default provider/model); the
# run exits 1 only when neither exists.
#
# The two lines below are read only on the own-key branch, and they drive more
# than the endpoint they name:
# - PPT_API_BASE, with the key's own prefix, is what tells raven WHICH gateway
#   this is. config.json deliberately names its provider block `ppt`, a name
#   raven carries no spec for, so nothing shadows that detection -- which is
#   what keeps prompt caching on where the endpoint supports it.
# - PPT_MODEL sizes the context window. The launcher asks the endpoint that
#   will serve the model (OpenRouter: the smallest window among the providers
#   the request may reach, every serving one unless `only` or an `order` with
#   fallbacks off fences it; a vLLM-style server: its max_model_len) and writes
#   the answer into agents.defaults.contextWindowTokens. When the endpoint does
#   not answer, LiteLLM's table and then the host's model catalog may only lower
#   the shipped number, never raise it. PPT_CONTEXT_WINDOW pins it by hand.
PPT_API_KEY=
PPT_MODEL=anthropic/claude-sonnet-5
PPT_API_BASE=https://openrouter.ai/api/v1
PPT_CONTEXT_WINDOW=

# Serper key for tools.web.search (https://serper.dev) - OPTIONAL: it falls
# back to the same path in the host config, and without one anywhere the deck
# loses its pictures, because web_search is the only tool that finds them.
PPT_SERPER_API_KEY=

# Jina Reader key for tools.web.jinaApiKey - OPTIONAL. r.jina.ai works
# unauthenticated at a lower rate limit; leave this empty rather than setting
# an exhausted key (a dead key answers 402 where no key answers 200).
PPT_JINA_API_KEY=

# Everything the agent persists lands under this root, never in this folder:
# the rendered config, the runtime data dir, transcripts and caches. It is
# the rendered config's parent that decides, so run.py renders the config
# here. Defaults to <raven home>/workspace/subagent_sessions/raven-ppt.
PPT_STATE_ROOT=

# Where the ACP engine keeps its own Agent home (identity, sessions, skill
# pool) - OPTIONAL, and outside the host Agent home by construction when
# unset: <raven home>/subagent_sessions/raven-ppt/acp, falling beside the
# host Agent home (tagged per instance) when that home swallows the default.
# The host hands its own Agent home out as a session's working directory,
# and an engine homed inside that tree makes every such dispatch refuse.
# Set this to move it; where it goes is then your business.
PPT_ACP_HOME=

# Key for the image generator (GPT Image 2 on OpenRouter), tools.media.image.apiKey
# - OPTIONAL. On the own-key branch with an OpenRouter PPT_API_BASE the LLM key is
# written here as well, so a deck can generate its backdrops with no extra setting;
# set this to pay for pictures from a different account, or when the LLM key is
# for another gateway.
PPT_IMAGE_API_KEY=
