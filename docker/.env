# Raven Compose settings. Read twice: by Compose, to fill ${...} in
# docker-compose.yml, and by the container, which receives every line below as
# an environment variable.
#
# THIS FILE IS COMMITTED. Do not put a real key in it -- write .env.local
# beside it instead (same KEY=value format, git-ignored, loaded after this one
# and wins).

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Tag the build produces and Compose runs.
RAVEN_IMAGE=evermind/raven:dev

# Host port the page is served on. Anything free; the engine's own port is
# internal and unaffected. Raven installed on the host uses 18792 by default,
# so Compose uses a different port and can run beside it.
RAVEN_WEB_PORT=18793

# Give browsers opening the published Compose port a Raven session cookie.
# Set to 0 on a remotely exposed deployment and use the one-time sign-in link.
RAVEN_AUTO_LOGIN=1

# The engine's port inside the container. Change only if something else in the
# container wants 18793; nginx follows it. Keeping this distinct from the host
# default also gives the browser session cookie a different name.
RAVEN_PAGE_PORT=18793

TZ=UTC

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

# Optional dependency extras compiled into the image, comma-separated.
# Available: channels, tools, sandbox, browser, eval.
# `sandbox` adds boxlite, `browser` adds playwright and a browser binary.
RAVEN_EXTRAS=channels,tools

# Distributables installed beside the host, comma-separated, from
# plugins-dist/. everos-memory backs the memory store the engine starts on
# boot. Add ppt-engine and design-engine to build decks and visual designs --
# together they pull matplotlib, pymupdf and cairo, so they are not default.
RAVEN_PLUGINS=everos-memory

# ---------------------------------------------------------------------------
# First-run provider (optional)
# ---------------------------------------------------------------------------
# Set a key, an address, or both and the entrypoint writes the provider into
# config on every boot, so a redeployment comes up already configured. Leave
# both empty and the page owns the configuration instead -- the engine starts
# either way.
#
# The name is the provider's slug, as `raven provider set` takes it:
#   anthropic, openai, deepseek, gemini, zai, groq, moonshot, dashscope,
#   openrouter, aihubmix, siliconflow, volcengine, nvidia-nim, minimax,
#   minimax-cn-api, azure-openai, hosted-vllm, lm-studio, ollama-chat, custom.

RAVEN_PROVIDER=openrouter
RAVEN_API_KEY=
# Only for a provider that needs an address: azure-openai, custom,
# ollama-chat, lm-studio, hosted-vllm, or your own gateway in front of a
# hosted vendor. A local server here is reached from inside the container, so
# use host.docker.internal rather than 127.0.0.1.
RAVEN_API_BASE=

# ---------------------------------------------------------------------------
# Vendor credentials (optional)
# ---------------------------------------------------------------------------
# Ambient keys, read by the provider layer where a vendor supports one. Left
# commented on purpose: an empty value is still a value, and a provider handed
# an empty key reports itself configured and then fails at the first call.
# Uncomment in .env.local, not here.
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# GROQ_API_KEY=
# ZAI_API_KEY=
# NVIDIA_NIM_API_KEY=
# MINIMAX_API_KEY=
# OLLAMA_API_KEY=
# HOSTED_VLLM_API_KEY=

# ---------------------------------------------------------------------------
# Engine internals (rarely needed)
# ---------------------------------------------------------------------------
# Seeds the session credentials instead of generating them per boot. Setting
# these pins a secret for the life of the deployment; the default is a fresh
# pair on every start, and the entrypoint prints the sign-in link.
#
# RAVEN_SERVE_TOKEN=
# RAVEN_SERVE_COOKIE=
