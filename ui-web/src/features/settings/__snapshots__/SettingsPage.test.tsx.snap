// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`settings island > keeps its rendered shape 1`] = `
"div.panel[data-on=true]
  div.scard
    div.empty-note"
`;

exports[`the models pane > keeps its rendered shape 1`] = `
"div.panel[data-on=true]
  div.msplit
    svg.model-tag-defs
      defs
        symbol#mtag-text
