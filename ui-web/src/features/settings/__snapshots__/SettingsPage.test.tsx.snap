        button.mrow
          img.provider-icon.mark-light[data-provider=ollama]
          img.provider-icon.mark-dark[data-provider=ollama]
          span.nm
    div.mpanel
      div.mtitle
        img.provider-icon[data-provider=anthropic][data-tone=hybrid]
        a.provider-link
          span
        span.tagm
        span.provider-status.on
