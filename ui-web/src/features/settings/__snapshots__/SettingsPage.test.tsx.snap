        symbol#mtag-audio-recognition
          rect
          path
        symbol#mtag-video-recognition
          rect
          path
        symbol#mtag-file-input
          path
          path
        symbol#mtag-image-generation
          rect
          path
          path
        symbol#mtag-audio-generation
          path
          path
        symbol#mtag-video-generation
