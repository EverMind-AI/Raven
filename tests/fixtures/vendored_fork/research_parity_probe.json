er itself and nothing else. Then the evidence that decides it, citing source URLs for web evidence and absolute paths for local files. Then, only if it is real, what remains uncertain.\nWhen the sources give the parts but not the total, do the arithmetic yourself: state the computed value, mark it as derived, and show the one-line formula over the cited inputs - a quantity you can compute from established facts is an answer, not a gap. When the question is a decision between options, end with a recommendation: what to do, what it costs, the strongest alternative, and what only the user can decide.", "measured_guidance": true, "fetch_max_chars": 14000, "search.include_answer_box": false, "search.include_knowledge_graph": false, "search.include_snippets": true, "search.snippet_dedup_by_docid": true, "search.cross_query_dedup": false, "search.search_depth": 20, "search.rendered_width": 5, "search.repeat_notice": true, "search.saturation.enabled": true, "search.saturation.identity": "url", "search.saturation.k": 5, "search.saturation.on_saturate": "widen", "search.saturation.max_pages": 2, "truncation_wrapup.enabled": false, "truncation_wrapup.max_tokens": 4096, "truncation_wrapup.reasoning_effort": "low", "reactive_clamp.enabled": false, "reactive_clamp.shrink_factor": 0.5, "digest.enabled": true, "digest.model": null, "digest.threshold_chars": 8000, "digest.timeout_seconds": 120.0, "digest.verbatim_head_chars": 0, "verify.enabled": true, "verify.model": null, "verify.timeout_seconds": 120.0, "verify.attempt_timeout_seconds": 40.0, "verify.attempt_http_timeout_seconds": null, "verify.reasoning_effort": null, "verify.max_revisions": 1, "verify.review_final_draft": false, "verify.max_tokens": 8192, "verify.constraint_rubric": true, "verify.strict_reject_only": true, "verify.fail_open_on_elided_evidence": true, "verify.evidence_round": false, "verify.evidence_round_searches": 6, "verify.evidence_round_depth": 50, "budget_note.enabled": true, "budget_note.warn_ratio": 0.3,