{
  "openrpc": "1.2.6",
  "info": {
    "title": "Raven Web RPC",
    "description": "The gateway control plane's raven.* dialect over ws://host:port/ws: the three live-channel methods raven.gateway.live_probe consumes. The config-admin vocabulary that once shared this contract died with the ui-webui front end (C7 ruling, 2026-08-29).",
    "version": "0.1.0",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "methods": [
    {
      "name": "raven.channels.qr",
      "params": [
        {
          "name": "name",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "raven.channels.qr.result",
        "schema": {
          "type": "object",
          "properties": {
            "qr": {
              "description": "Login QR as a PNG data URI, or null when none is pending.",
              "type": "string"
            },
            "qr_text": {
              "description": "Raw scan payload when the gateway cannot rasterise a PNG.",
              "type": "string"
            },
            "connected": {
              "type": "boolean"
            },
            "running": {
              "type": "boolean"
            },
            "rebind": {
              "description": "Null for a channel that does not offer rebinding.",
              "type": "object",
              "properties": {
                "phase": {
                  "description": "idle | waiting | scanned | confirmed | failed | cancelled.",
                  "type": "string"
                },
                "refreshes": {
                  "description": "Codes reissued so far, against max_refreshes.",
                  "type": "integer"
                },
                "max_refreshes": {
                  "type": "integer"
                },
                "code_age_s": {
                  "description": "Seconds since the current code was issued; null when none is up.",
                  "type": "number"
                },
                "detail": {
                  "description": "Why it failed, when it did: expired | no_token | error.",
                  "type": "string"
                }
              },
              "required": [
                "phase",
                "refreshes",
                "max_refreshes",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "connected",
            "running"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "name": "raven.channels.start",
      "summary": "Start or stop one channel's adapter now, without a gateway restart.",
      "params": [
        {
          "name": "name",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "enabled",
          "required": false,
          "schema": {
            "type": "boolean"
          },
          "description": "False stops the adapter; anything else starts it."
        }
      ],
      "result": {
        "name": "raven.channels.start.result",
        "schema": {
          "type": "object",
          "properties": {
            "outcome": {
              "description": "started | already | stopped | absent | disabled | deny_all | missing_dep | unknown | no_manager.",
              "type": "string"
            }
          },
          "required": [
            "outcome"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "name": "raven.channels.live",
      "params": [],
      "result": {
        "name": "raven.channels.live.result",
        "schema": {
          "type": "object",
          "properties": {
            "channels": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "running": {
                    "type": "boolean"
                  },
                  "connected": {
                    "description": "Three-valued: null means the channel does not report a pairing at all.",
                    "type": "boolean"
                  },
                  "qr_login": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "qr_login",
                  "running"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "channels"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "components": {
    "schemas": {}
  }
}
