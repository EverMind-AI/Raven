    "ThirdPartyAcpSubagentConfig": {
      "description": "A third-party agent reached over ACP (Agent Client Protocol), e.g. ``hermes acp``.\n\n``command`` starts a *server* and is spawned once per connection, not once\nper task: a task is delivered as a ``session/prompt`` request on the running\nconnection. So unlike a cli entry it carries no ``{prompt}`` placeholder,\nand none of the fields listed in :data:`ACP_UNSUPPORTED_FIELDS`.\n\nThose seven are absent by design rather than by omission. Each one is a cli\n*declaration* about behaviour (can it resume, who mints the session id, how\nis its transcript shaped) whose acp counterpart comes from the ``initialize``\nhandshake instead. Accepting both would make every one of them a second\nsource of truth, and the first time a declaration disagreed with the\nhandshake nothing in the code would know which to believe.",
      "properties": {
        "allowMcpSecrets": {
          "default": false,
          "title": "Allowmcpsecrets",
          "type": "boolean"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "engine": {
