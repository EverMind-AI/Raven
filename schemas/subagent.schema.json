  "$defs": {
    "SubagentEngineConfig": {
      "description": "The engine wheel a folder-discovered agent declares, as\n``{\"package\": \"<import name>\", \"wheel\": \"<distribution name>\"}``.\n\nDeclared by the folder's ``subagent.json`` (the ``raven agents new\n--engine-wheel`` scaffold writes it); readiness probes the package where\nraven runs and lists the row disabled, naming the wheel, until it imports.\nCarried on the config row so a pinned copy of the manifest round-trips the\ndeclaration instead of silently dropping it -- discovery itself keeps\nreading the manifest fresh (``vendored_agents._declared_engine``), so this\nfield changes no merge or readiness semantics.",
      "properties": {
        "package": {
          "default": "",
          "title": "Package",
          "type": "string"
        },
        "wheel": {
          "default": "",
          "title": "Wheel",
          "type": "string"
        }
      },
      "title": "SubagentEngineConfig",
      "type": "object"
    },
    "SubagentEverosConfig": {
      "description": "A sub-agent's everos identity, as the host must address it to read back\nwhat that sub-agent wrote.\n\nDeclared rather than discovered. The alternative -- reading the fork's own\nconfig.json next to its ``run.py`` -- would couple the host to a directory\nconvention that lives entirely inside each fork.",
      "properties": {
        "agentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
