          "default": null
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "kind": {
          "const": "acp",
          "default": "acp",
          "title": "Kind",
          "type": "string"
        },
        "maxOutputChars": {
          "default": 30000,
