            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseurl"
        },
        "sessionPrefix": {
          "default": "cli:",
          "title": "Sessionprefix",
          "type": "string"
        },
        "source": {
          "default": "agent",
          "enum": [
            "agent",
            "trace"
          ],
          "title": "Source",
          "type": "string"
        },
        "userId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Userid"
        }
