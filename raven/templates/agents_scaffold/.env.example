# Copy to `.env`, fill in, and `chmod 600 .env`.
#
# run.py merges these into the config it renders at launch; config.json stays
# free of secrets and is safe to publish. Every value can also be exported in
# the environment instead, which wins over this file.

# LLM provider key for providers.custom (an OpenRouter key by default). Leave
# it empty to inherit the host raven's whole LLM configuration instead
# (providers, routing, default provider/model); the run exits 1 only when
# neither exists. NOTE: setting a key here (own-key mode) also requires a
# providers/agents.defaults block in config.json naming the provider and
# model -- the shipped config.json carries neither and relies on inheritance.
MY_AGENT_API_KEY=

# Everything the agent persists lands under this root, never in this folder:
# the workspace, the rendered config, and the my-agent-flow plugin's own
# state. It is the rendered config's parent that decides, so run.py renders
# the config here.
# Defaults to <raven home>/workspace/subagent_sessions/my-agent.
MY_AGENT_STATE_ROOT=

# Where the ACP engine keeps its own Agent home (identity, sessions, skill
# pool) - OPTIONAL, and outside the host Agent home by construction when
# unset: <raven home>/subagent_sessions/my-agent/acp. Set this to move it;
# where it goes is then your business.
MY_AGENT_ACP_HOME=
